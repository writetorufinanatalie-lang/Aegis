# AEGIS Backend — server-side only
# Copy to backend/.env for local
# No API key required for Open-Meteo (open)
PORT=8000

# Financial provider — MVP: simulated (no credentials needed)
# For future regulated Account Aggregator, set:
# FINANCIAL_PROVIDER=account_aggregator
# FINANCIAL_PROVIDER_SECRET=__secret_stays_server_side_only__
# AGGREGATOR_API_KEY=__never_commit_real_key__
FINANCIAL_PROVIDER=simulated
